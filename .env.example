# ===== AI (optional) =====
# SiliconFlow API key for AI suggestion features.
SILICONFLOW_API_KEY=

# Optional provider marker (reserved for future providers).
AI_PROVIDER=siliconflow

# Prompt recommendation model routing.
AI_MODEL_PRIMARY=Pro/zai-org/GLM-5.1
AI_MODEL_FALLBACK=Pro/zai-org/GLM-5.1

# Generic key used by prompt recommendation path.
AI_API_KEY=

# Backward-compatible model var for existing AI endpoints.
AI_MODEL=ZhipuAI/GLM-4.5

# Prompt recommendation timeout (ms) for each model call.
AI_TIMEOUT_MS=2000

# ===== API server =====
# Backend listen port/host (for local or cloud runtime).
PORT=3210
HOST=0.0.0.0

# Comma-separated CORS allowlist, used when frontend and backend are on different domains.
# Example: https://skill-dashboard.vercel.app,https://your-domain.com
CORS_ORIGIN=

# ===== Frontend build =====
# In production, set to your public API base URL (no trailing slash), for example:
# VITE_API_BASE_URL=https://skill-dashboard-api.onrender.com
VITE_API_BASE_URL=

# Local dev only: Vite proxy target for /api
VITE_API_PROXY_TARGET=http://127.0.0.1:3210
